# Copy to .env and adjust. All optional — sensible SauceDemo defaults are built in.
# Shell variables win over .env.
TEST_ENV=dev              # dev | staging | prod
# BASE_URL=https://www.saucedemo.com
# Required when the target is not SauceDemo; otherwise its public demo user is used.
# SAUCE_USERNAME=standard_user
# SAUCE_PASSWORD=secret_sauce
