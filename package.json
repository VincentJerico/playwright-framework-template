{
  "name": "playwright-framework-template",
  "version": "1.0.0",
  "description": "A production-grade Playwright + TypeScript test framework template: fixtures, POM, multi-env config, storage-state auth, data factories, cross-browser, and CI.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "sdet",
    "qa",
    "framework",
    "e2e"
  ],
  "author": "Vincent Jerico",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.8.0"
  }
}
